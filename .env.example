# Copy this file to .env and fill it in. .env is git-ignored; never commit real values.
# The app reads .env when it runs locally. On Render, set the same names in the service's
# Environment settings instead. See docs/deployment.md for the full setup.

# --- Database (required) -------------------------------------------------------------------
# Local: the steelsight-db Docker container.
DB_URL=jdbc:postgresql://localhost:55433/steelsight_local
DB_USERNAME=postgres
DB_PASSWORD=

# Render: Supabase's session pooler, not the direct connection, which is IPv6 only.
# DB_URL=jdbc:postgresql://<pooler host>:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project ref>
# DB_PASSWORD=<the Supabase database password>

# --- First admin ---------------------------------------------------------------------------
# Used only when the database has no admin yet. Leave the password empty to skip it.
ADMIN_EMPLOYEE_CODE=ADMIN
ADMIN_PASSWORD=

# --- Detection service API (required on Render) --------------------------------------------
# The key the detection software sends as X-Api-Key. Empty means the API refuses every call.
# Make one with: openssl rand -hex 32
STEELSIGHT_DETECTION_API_KEY=

# --- Supabase Storage (required on Render) -------------------------------------------------
# Locally, photos go to ./uploads and these can stay empty. The prod profile on Render uses
# Supabase and won't start without the URL and key. Both buckets must be private.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=ticket-photos
SUPABASE_FACE_BUCKET=face-photos

# --- Optional ------------------------------------------------------------------------------
# Keep the time zone the same as safety_policy.time_zone in the database.
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# The late rule for people with no team. Teams set their own on the Team page.
LATE_AFTER_MINUTES=15
# DEBUG logs each request start, or every SQL statement.
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
# Local photo folder.
STORAGE_DIR=./uploads

# Don't set these: Render sets PORT, and the prod profile sets the other two.
# PORT, SESSION_COOKIE_SECURE, STORAGE_TYPE

# --- Detection service (its own codebase, not read by this app) ----------------------------
# It connects as its own limited role. Run this once in Supabase's SQL editor after the
# first deploy:  ALTER ROLE steelsight_detection LOGIN PASSWORD '<a strong password>';
# DETECTION_DB_HOST=<pooler host>
# DETECTION_DB_USER=steelsight_detection.<project ref>
# DETECTION_DB_PASSWORD=<that password>
# DETECTION_SUPABASE_URL=https://<project ref>.supabase.co
# DETECTION_SUPABASE_KEY=<the Supabase server key>
# DETECTION_FACE_BUCKET=face-photos
# DETECTION_ERP_URL=https://<your service>.onrender.com
# DETECTION_ERP_API_KEY=<the same value as STEELSIGHT_DETECTION_API_KEY>
