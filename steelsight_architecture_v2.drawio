          <mxGeometry x="30" y="290" width="1640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;Test&lt;/b&gt;&lt;br&gt;pytest on rules and sync,&lt;br&gt;no GPU needed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="20" y="50" width="170" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;Scan&lt;/b&gt;&lt;br&gt;Semgrep on code&lt;br&gt;Trivy on dependencies" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="240" y="50" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;git pull, then build&lt;/b&gt;&lt;br&gt;docker compose up --build&lt;br&gt;uses no CI minutes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#166534;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="480" y="50" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;GPU in Docker&lt;/b&gt;&lt;br&gt;Docker Desktop on WSL2 with the NVIDIA driver" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#166534;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="720" y="50" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;Model weights&lt;/b&gt;&lt;br&gt;mounted volume, kept out of the image" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44403C;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="960" y="50" width="200" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;Detection service&lt;/b&gt;&lt;br&gt;runs while the laptop is on, then drains the outbox when back online" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontSize=11;fontColor=#292524;align=center;verticalAlign=middle;spacingLeft=0;spacing=6;" parent="b" vertex="1">
          <mxGeometry x="1210" y="50" width="230" height="115" as="geometry" />
        </mxCell>
        <mxCell id="dep_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#44403C;fontSize=10;fontColor=#292524;labelBackgroundColor=#FFFFFF;startArrow=none;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="b1" target="b2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_8" value="by hand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#44403C;fontSize=10;fontColor=#292524;labelBackgroundColor=#FFFFFF;startArrow=none;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="b2" target="b3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#44403C;fontSize=10;fontColor=#292524;labelBackgroundColor=#FFFFFF;startArrow=none;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="b3" target="b4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#44403C;fontSize=10;fontColor=#292524;labelBackgroundColor=#FFFFFF;startArrow=none;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="b4" target="b5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#44403C;fontSize=10;fontColor=#292524;labelBackgroundColor=#FFFFFF;startArrow=none;exitX=1.0;exitY=0.4957;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4957;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="b5" target="b6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep_12" value="&lt;b&gt;Why the laptop isn&#39;t deployed by CI&lt;/b&gt;&lt;br&gt;It isn&#39;t always on, and it&#39;s the only machine with a GPU. A GitLab Runner would add setup without helping the demo. If you later get a fixed site machine, add a protected runner there." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#854D0E;fontSize=11;fontColor=#292524;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="30" y="510" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dep_13" value="&lt;b&gt;Where secrets live, never in the repository&lt;/b&gt;&lt;br&gt;GitLab CI variables (masked, protected): Render deploy hook, registry token.&lt;br&gt;Render environment: JDBC URL, ERP DB password, Supabase storage key, email API key.&lt;br&gt;Laptop .env file, listed in .gitignore: detection DB role, storage key." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#854D0E;fontSize=11;fontColor=#292524;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="450" y="510" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dep_14" value="&lt;b&gt;Schema changes&lt;/b&gt;&lt;br&gt;Only the ERP runs migrations (Flyway). Detection never alters tables. When a change affects both, add the new column first, deploy detection, then remove the old one." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#854D0E;fontSize=11;fontColor=#292524;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="870" y="510" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dep_15" value="&lt;b&gt;Demo-day backup&lt;/b&gt;&lt;br&gt;If Render is too slow, run the same ERP image on the laptop and expose it with a Cloudflare Tunnel: cloudflared tunnel --url http://localhost:8080. Nothing else changes, because the database and storage stay on Supabase." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#854D0E;fontSize=11;fontColor=#292524;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="1270" y="510" width="400" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
